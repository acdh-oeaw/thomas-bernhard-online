# =================================================================================================
# environment variables
# =================================================================================================

# =================================================================================================
# app
# =================================================================================================

NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"
# imprint service
NEXT_PUBLIC_IMPRINT_SERVICE_BASE_URL="https://imprint.acdh.oeaw.ac.at"
NEXT_PUBLIC_REDMINE_ID="28690"
# web crawlers
NEXT_PUBLIC_BOTS="disabled"
# validate environment variables
ENV_VALIDATION="enabled"

# =================================================================================================
# analytics
# =================================================================================================

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_MATOMO_BASE_URL="https://matomo.acdh.oeaw.ac.at"
# NEXT_PUBLIC_MATOMO_ID=

# =================================================================================================
# typesense
# =================================================================================================

# local server: `pnpm run typesense:up`, then `pnpm run typesense:seed-local`
NEXT_PUBLIC_TYPESENSE_COLLECTION_PREFIX="tbo_"
NEXT_PUBLIC_TYPESENSE_COLLECTIONS="event,group,performance,person,publication,work,translation"
NEXT_PUBLIC_TYPESENSE_HOST="localhost"
NEXT_PUBLIC_TYPESENSE_PORT="8108"
NEXT_PUBLIC_TYPESENSE_PROTOCOL="http"
NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY="local-search-api-key"
TYPESENSE_ADMIN_API_KEY="local-admin-api-key"
TYPESENSE_SEED_HOST="typesense.acdh.oeaw.ac.at"
TYPESENSE_SEED_SEARCH_API_KEY=
