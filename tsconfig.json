{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@acdh-oeaw/tsconfig",
	"compilerOptions": {
		"paths": {
			"#/*": ["./*"]
		},
		"types": ["node", "react", "react-dom"],
		"plugins": [{ "name": "next" }]
	},
	"include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
	"exclude": ["content", "node_modules", "out", "public"]
}
