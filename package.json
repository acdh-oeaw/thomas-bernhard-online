{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@acdh-oeaw/thomas-bernhard-online",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "next analyze",
		"build": "next build",
		"dev": "next dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "pnpm run types:generate",
		"start": "next start",
		"start:standalone": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && node .next/standalone/server.js",
		"styles:check": "stylelint \"./**/*.css\" --ignore-path ./.gitignore",
		"styles:fix": "stylelint \"./**/*.css\" --fix --ignore-path ./.gitignore",
		"test": "exit 0",
		"test:e2e": "playwright test --config ./config/playwright.config.ts",
		"test:e2e:install": "playwright install --with-deps",
		"types:check": "tsc --noEmit",
		"types:generate": "ENV_VALIDATION=disabled next typegen",
		"typesense:create-joined-schema": "node --env-file-if-exists=./.env.local ./scripts/typesense/create-joined-schema.ts",
		"typesense:demonstrate-joins": "node --env-file-if-exists=./.env.local ./scripts/typesense/demonstrate-joins.ts",
		"typesense:generate-schema": "node --env-file-if-exists=./.env.local ./scripts/typesense/get-schema.ts",
		"typesense:local:down": "docker compose -f ./docker/compose.yaml down",
		"typesense:local:seed": "node --env-file-if-exists=./.env.local ./scripts/typesense/seed-local.ts",
		"typesense:local:up": "docker compose -f ./docker/compose.yaml up -d --wait"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@acdh-oeaw/validate-env": "^0.4.0",
		"@react-aria/utils": "^3.34.1",
		"@valibot/i18n": "^1.3.0",
		"client-only": "^0.0.1",
		"image-dimensions": "^2.6.0",
		"lucide-react": "^1.82.0",
		"next": "^16.4.6",
		"next-intl": "^4.16.2",
		"nuqs": "^2.10.3",
		"react": "^19.3.1",
		"react-aria": "^3.53.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.1",
		"react-schemaorg": "^2.0.1",
		"react-stately": "^3.51.0",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"typesense": "^3.3.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@oxlint/plugins": "^1.95.0",
		"@playwright/test": "^1.65.1",
		"@react-aria/optimize-locales-plugin": "^2.1.0",
		"@tailwindcss/turbopack": "^4.3.5",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.1.0",
		"eslint-plugin-playwright": "^2.12.2",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.4",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2009",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"tailwindcss-react-aria-components": "^2.2.0",
		"typescript": "^7.0.2"
	},
	"browserslist": [
		"chrome >= 111",
		"edge >= 111",
		"firefox >= 128",
		"safari >= 16.4",
		"ios_saf >= 16.4"
	],
	"stylelint": {
		"extends": "./config/stylelint.config.ts"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.24.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26.13.1",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "node",
			"version": "^26.13.1",
			"onFail": "download"
		}
	}
}
